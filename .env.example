# Sahaya Setu - Environment Variables Configuration

# Server & Database
PORT=8000
MONGODB_URI=mongodb://127.0.0.1:27017/sahaya_setu
NODE_ENV=development

# JWT Authentication
JWT_SECRET=sahaya-setu-secure-jwt-secret-key-2026
JWT_EXPIRES_IN=7d

# Cloudinary Storage (Optional: if empty, files are stored locally in uploads/)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Geocoding Service (offline = local CSV places, nominatim = OpenStreetMap online API)
GEOCODER=offline
NOMINATIM_URL=https://nominatim.openstreetmap.org/reverse

# Duplicate Detection Configuration
DUP_RADIUS_M=200
DUP_RADIUS_TEXT_ONLY_M=50
DUP_RADIUS_MAX_M=300
PHASH_MAX_DISTANCE=8

# SLA & Background Escalation Check Interval (in seconds)
ESCALATION_INTERVAL_S=300

# SMS & Offline Gateway (Optional)
SMS_SENDER=console
SMS_GATEWAY_URL=
SMS_INBOUND_NUMBER=
